NEXT_PUBLIC_AZURE_CLIENT_ID=your-application-client-id
NEXT_PUBLIC_AZURE_TENANT_ID=your-directory-tenant-id
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=allumiax.com
NEXT_PUBLIC_AZURE_AUTHORITY=https://login.microsoftonline.com/organizations

# Vercel Blob (auto-added when you create a Blob store in Vercel → Storage)
# Required on Vercel so allotted hours, holidays, and users persist for everyone.
BLOB_READ_WRITE_TOKEN=your_blob_read_write_token_here

# Clockify (same workspace as ALX TV Dashboard)
CLOCKIFY_API_KEY=your_clockify_api_key_here
CLOCKIFY_WORKSPACE_ID=your_workspace_id_here
CLOCKIFY_WORKSPACE_TIMEZONE=America/Los_Angeles
